<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1C1410" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Roots Record" />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icon.svg" />
  <title><%= it.title ?? "Roots Record" %></title>
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <link rel="stylesheet" href="/styles.css" />
  <style>
    html,body{margin:0;background:#F1F5F9}
    .site-header{background:#1E293B;min-height:68px;border-bottom:3px solid var(--gold,#166534)}
    html[data-theme="ocean"]  {--gold:#1D4ED8}
    html[data-theme="ember"]  {--gold:#B45309}
    html[data-theme="plum"]   {--gold:#6D28D9}
    html[data-theme="teal"]   {--gold:#0F766E}
  </style>
  <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('rr-theme') || 'forest');</script>
  <script type="module" src="/datastar.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script src="/components.js" defer></script>
</head>
<body>
  <header class="site-header" data-store="{navOpen: false}">
    <div class="header-inner">
      <a href="/" class="nav-brand">
        <span class="brand-mark">R</span>
        <span class="brand-text">Roots Record</span>
      </a>
      <% if (it.user) { %>
        <nav class="main-nav" id="main-nav" aria-label="Main navigation">
        </nav>
        <div class="nav-end">
          <button class="nav-qr-btn" id="qr-btn" aria-label="QR Code" title="QR Code">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
              <rect x="14" y="14" width="3" height="3"/><rect x="18" y="14" width="3" height="3"/><rect x="14" y="18" width="3" height="3"/><rect x="18" y="18" width="3" height="3"/>
            </svg>
          </button>
          <button class="nav-avatar" id="nav-hamburger" aria-label="Toggle menu"
                data-class-is-open="navOpen"
                data-on:click="$navOpen = !$navOpen">
            <%= (it.user?.name ?? it.user?.email ?? '?')[0].toUpperCase() %>
          </button>
        </div>
      <% } %>
    </div>
    <% if (it.user) { %>
      <div class="mobile-nav-overlay" data-show="$navOpen" data-on:click="$navOpen = false" style="display:none"></div>
      <div class="mobile-nav" data-show="$navOpen" style="display:none">
        <div class="mobile-nav-user">
          <span class="mobile-nav-user-name"><%= it.user.name ?? it.user.email %></span>
          <div class="mobile-nav-sep"></div>
        </div>
        <div class="mobile-nav-theme" id="nav-theme-row">
          <span class="mobile-nav-theme-label">Theme</span>
          <svg class="mobile-nav-theme-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          <theme-picker></theme-picker>
        </div>
        <a href="/profile" class="mobile-nav-link">Profile</a>
        <a href="/auth/sign-out" class="mobile-nav-link">Sign out</a>
      </div>
    <% } %>
  </header>

  <% if (it.breadcrumbs && it.breadcrumbs.length > 0) { %>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/" class="breadcrumb-home">Home</a>
    <% for (const crumb of it.breadcrumbs) { %>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <% if (crumb.href) { %>
        <a href="<%= crumb.href %>" class="breadcrumb-link"><%= crumb.label %></a>
      <% } else { %>
        <span class="breadcrumb-current" aria-current="page"><%= crumb.label %></span>
      <% } %>
    <% } %>
  </nav>
  <% } %>

  <main class="site-main">
    <%~ it.body %>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-brand">Roots Record</span>
      <span class="footer-tagline">Preserving family history across generations</span>
      <a href="https://darrickdevelops.com" class="footer-dev" target="_blank" rel="noopener">Built by Darrick Develops</a>
    </div>
  </footer>

  <confirm-dialog id="confirm-el"></confirm-dialog>
  <qr-modal id="qr-modal"></qr-modal>

  <script>
    function confirmAction(msg, cb) {
      document.getElementById('confirm-el').show(msg, cb);
    }
    document.getElementById('qr-btn').addEventListener('click', () => {
      document.getElementById('qr-modal').show();
    });
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
  </script>
</body>
</html>
