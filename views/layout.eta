<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1C1410" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Roots Record" />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icon.svg" />
  <title><%= it.title ?? "Roots Record" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;1,400;1,700&family=Nunito:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@1.0.0-RC.8/bundles/datastar.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body>
  <header class="site-header" data-store="{navOpen: false}">
    <div class="header-inner">
      <a href="/" class="nav-brand">
        <span class="brand-mark">R</span>
        <span class="brand-text">Roots Record</span>
      </a>
      <% if (it.user) { %>
        <nav class="main-nav" id="main-nav" aria-label="Main navigation">
          <a href="/people" class="nav-link">People</a>
          <a href="/tree" class="nav-link">Family Tree</a>
          <a href="/people/new" class="nav-link nav-link--cta">Add Person</a>
        </nav>
        <div class="user-menu">
          <span class="user-name"><%= it.user.name ?? it.user.email %></span>
          <a href="/auth/sign-out" class="sign-out">Sign out</a>
        </div>
        <div class="nav-end">
          <div class="theme-wrap">
            <button class="theme-btn" id="theme-btn" aria-label="Choose color theme" title="Choose theme" onclick="toggleThemePicker(event)"></button>
            <div class="theme-picker" id="theme-picker">
              <button class="theme-swatch" data-theme="forest"  style="--sw:#166534" title="Forest"  onclick="pickTheme('forest')"></button>
              <button class="theme-swatch" data-theme="ocean"   style="--sw:#1D4ED8" title="Ocean"   onclick="pickTheme('ocean')"></button>
              <button class="theme-swatch" data-theme="ember"   style="--sw:#B45309" title="Ember"   onclick="pickTheme('ember')"></button>
              <button class="theme-swatch" data-theme="plum"    style="--sw:#6D28D9" title="Plum"    onclick="pickTheme('plum')"></button>
              <button class="theme-swatch" data-theme="teal"    style="--sw:#0F766E" title="Teal"    onclick="pickTheme('teal')"></button>
            </div>
          </div>
          <button class="nav-qr-btn" onclick="showQR()" aria-label="QR Code" title="QR Code">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
              <rect x="14" y="14" width="3" height="3"/><rect x="18" y="14" width="3" height="3"/><rect x="14" y="18" width="3" height="3"/><rect x="18" y="18" width="3" height="3"/>
            </svg>
          </button>
          <button class="nav-avatar" id="nav-hamburger" aria-label="Toggle menu"
                data-class-is-open="navOpen"
                data-on:click="$navOpen = !$navOpen">
            <%= (it.user?.name ?? it.user?.email ?? '?')[0].toUpperCase() %>
          </button>
        </div>
      <% } %>
    </div>
    <% if (it.user) { %>
      <div class="mobile-nav-overlay" data-show="$navOpen" data-on:click="$navOpen = false"></div>
      <div class="mobile-nav" data-show="$navOpen">
        <a href="/people" class="mobile-nav-link">People</a>
        <a href="/tree" class="mobile-nav-link">Family Tree</a>
        <a href="/people/new" class="mobile-nav-link mobile-nav-link--cta">+ Add Person</a>
        <div class="mobile-nav-user">
          <span><%= it.user.name ?? it.user.email %></span>
          <a href="/auth/sign-out">Sign out</a>
        </div>
      </div>
    <% } %>
  </header>

  <% if (it.breadcrumbs && it.breadcrumbs.length > 0) { %>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/" class="breadcrumb-home">Home</a>
    <% for (const crumb of it.breadcrumbs) { %>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <% if (crumb.href) { %>
        <a href="<%= crumb.href %>" class="breadcrumb-link"><%= crumb.label %></a>
      <% } else { %>
        <span class="breadcrumb-current" aria-current="page"><%= crumb.label %></span>
      <% } %>
    <% } %>
  </nav>
  <% } %>

  <main class="site-main">
    <%~ it.body %>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-brand">Roots Record</span>
      <span class="footer-tagline">Preserving family history across generations</span>
    </div>
  </footer>

  <dialog id="qr-dialog">
    <div class="qr-dialog-inner">
      <p class="qr-url" id="qr-url-text"></p>
      <div id="qr-img"></div>
      <button class="outline" onclick="document.getElementById('qr-dialog').close()">Close</button>
    </div>
  </dialog>

  <dialog id="confirm-dialog">
    <div class="confirm-dialog-inner">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="confirm-icon" aria-hidden="true">
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <p id="confirm-message" class="confirm-message">Are you sure?</p>
      <div class="confirm-actions">
        <button class="outline" onclick="document.getElementById('confirm-dialog').close()">Cancel</button>
        <button class="danger" id="confirm-ok">Delete</button>
      </div>
    </div>
  </dialog>

  <script>
    // Confirm modal
    function confirmAction(message, onConfirm) {
      const dialog = document.getElementById('confirm-dialog');
      document.getElementById('confirm-message').textContent = message;
      const ok = document.getElementById('confirm-ok');
      const newOk = ok.cloneNode(true);
      ok.parentNode.replaceChild(newOk, ok);
      newOk.addEventListener('click', () => { dialog.close(); onConfirm(); });
      dialog.showModal();
    }
    document.getElementById('confirm-dialog').addEventListener('click', function(e) {
      if (e.target === this) this.close();
    });

    // QR code
    let _qr;
    function showQR() {
      const dialog = document.getElementById('qr-dialog');
      const url = location.origin;
      document.getElementById('qr-url-text').textContent = url;
      dialog.showModal();
      const el = document.getElementById('qr-img');
      el.innerHTML = '';
      _qr = new QRCode(el, { text: url, width: 220, height: 220 });
    }
    document.getElementById('qr-dialog').addEventListener('click', function(e) {
      if (e.target === this) this.close();
    });

    // Theme picker
    const _themes = ['forest','ocean','ember','plum','teal'];
    function applyTheme(name) {
      document.documentElement.setAttribute('data-theme', name);
      localStorage.setItem('rr-theme', name);
      document.querySelectorAll('.theme-swatch').forEach(s => {
        s.classList.toggle('is-active', s.dataset.theme === name);
      });
    }
    function pickTheme(name) {
      applyTheme(name);
      document.getElementById('theme-picker').classList.remove('is-open');
    }
    function toggleThemePicker(e) {
      e.stopPropagation();
      document.getElementById('theme-picker').classList.toggle('is-open');
    }
    document.addEventListener('click', () => {
      document.getElementById('theme-picker')?.classList.remove('is-open');
    });
    applyTheme(localStorage.getItem('rr-theme') || 'forest');

    // Service worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js');
    }
  </script>
</body>
</html>
