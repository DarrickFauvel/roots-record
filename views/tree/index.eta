<div class="page-header">
  <h1>Family Tree</h1>
</div>

<div class="tree-selector" data-signals='{"root_id":"<%= it.rootId ?? "" %>"}'>
  <div>
    <label for="root-select">Starting from</label>
    <select id="root-select" data-bind="root_id" data-on:change="$root_id && @get('/api/tree/' + $root_id)">
      <option value="">— Select a person —</option>
      <% for (const p of it.people) { %>
        <option value="<%= p.id %>" <% if (p.id === it.rootId) { %>selected<% } %>>
          <%= p.given_name %> <%= p.surname ?? "" %><% if (p.birth_date) { %> (<%= fmtYear(p.birth_date) %>)<% } %>
        </option>
      <% } %>
    </select>
  </div>
</div>

<div id="tree-container" class="tree-container">
  <% if (it.rootId && it.tree) { %>
    <ul><%~ include("../partials/tree-node", { node: it.tree }) %></ul>
  <% } else { %>
    <p class="tree-placeholder">Select a person above to view their descendants.</p>
  <% } %>
</div>
