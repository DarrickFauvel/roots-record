<div class="document-list">
  <% if (it.documents.length > 0) { %>
    <ul class="doc-grid">
      <% for (const d of it.documents) { %>
        <li class="doc-card">
          <a href="<%= d.signed_url %>" target="_blank" rel="noopener">
            <img src="<%= d.signed_thumb_url %>" alt="<%= d.title %>" loading="lazy" />
            <span><%= d.title %></span>
            <small><%= d.doc_type.replace(/_/g, " ") %></small>
          </a>
          <div class="doc-card-actions">
            <button
              class="small outline"
              data-doc-id="<%= d.id %>"
              data-signed-url="<%= d.signed_url %>"
              data-person-id="<%= it.personId %>"
              data-has-crop="<%= d.crop_data ? '1' : '' %>"
              onclick="openCropModal(this)"
            >Crop</button>
            <button
              class="small outline"
              data-on:click="confirmAction('Delete this document? This cannot be undone.', () => @delete('/api/documents/<%= d.id %>').then(()=>@get('/api/people/<%= it.personId %>/documents')))"
            >Delete</button>
          </div>
        </li>
      <% } %>
    </ul>
  <% } else { %>
    <p><em>No documents uploaded yet.</em></p>
  <% } %>

  <details>
    <summary>Upload Document / Photo</summary>
    <form
      method="POST"
      action="/api/documents"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="person_id" value="<%= it.personId %>" />

      <label>Title</label>
      <input type="text" name="title" required placeholder="Birth Certificate, Wedding Photo…" />

      <label>Type</label>
      <select name="doc_type">
        <option value="other">Other</option>
        <option value="birth_certificate">Birth Certificate</option>
        <option value="death_certificate">Death Certificate</option>
        <option value="marriage_certificate">Marriage Certificate</option>
        <option value="photo">Photo</option>
      </select>

      <label>File</label>
      <input type="file" name="file" required accept="image/*,.pdf" />

      <label>Notes (optional)</label>
      <input type="text" name="notes" />

      <button type="submit">Upload</button>
    </form>
  </details>
</div>

