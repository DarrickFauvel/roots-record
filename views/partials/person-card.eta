<li id="person-<%= it.p.id %>" class="person-card">
  <a href="/people/<%= it.p.id %>">
    <span class="person-name-row">
      <strong><%= it.p.given_name %><%= it.p.middle_name ? ` ${it.p.middle_name[0]}.` : "" %> <%= it.p.surname ?? "" %></strong>
      <% if (it.p.rel_count > 0) { %><span class="person-rel-count"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><%= it.p.rel_count %><span class="person-rel-label">relations</span></span><% } %>
    </span>
    <% if (it.p.birth_place) { %><span class="person-place"><%= it.p.birth_place %></span><% } %>
    <span class="person-meta">
      <% if (it.p.birth_date) { %><span>b. <%= fmtDate(it.p.birth_date) %></span><% } %>
      <% if (it.p.death_date) { %><span>d. <%= fmtDate(it.p.death_date) %></span><% } %>
    </span>
  </a>
</li>
