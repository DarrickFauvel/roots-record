<% const p = it.person; %>
<div class="page-header">
  <div>
    <h1><%= p.given_name %><%= p.middle_name ? ` ${p.middle_name}` : "" %> <%= p.surname ?? "" %><% if (p.maiden_name) { %> <span style="color:var(--muted);font-size:0.8em;font-style:italic">(née <%= p.maiden_name %>)</span><% } %></h1>
    <% if (p.sex && p.sex !== 'unknown') { %>
      <small style="color:var(--muted)"><%= p.sex === 'M' ? 'Male' : p.sex === 'F' ? 'Female' : p.sex %></small>
    <% } %>
  </div>
  <div style="display:flex;gap:.5rem;flex-wrap:wrap">
    <a href="/people/<%= p.id %>/edit" role="button" class="outline">Edit</a>
    <button class="outline danger small" data-on:click="confirmAction('Permanently delete this person and all their records?', () => @delete('/api/people/<%= p.id %>').then(()=>window.location='/people'))">Delete</button>
  </div>
</div>

<dl class="vital-facts">
  <% if (p.birth_date || p.birth_place) { %>
    <dt>Born</dt>
    <dd><%= [fmtDate(p.birth_date), p.birth_place].filter(Boolean).join(' — ') %></dd>
  <% } %>
  <% if (p.death_date || p.death_place) { %>
    <dt>Died</dt>
    <dd><%= [fmtDate(p.death_date), p.death_place].filter(Boolean).join(' — ') %><% if (p.death_cause) { %> <span style="color:var(--muted)">(<%= p.death_cause %>)</span><% } %></dd>
  <% } %>
</dl>

<% if (p.notes) { %>
  <div class="panel" style="margin-top:0"><p style="margin:0;font-style:italic"><%= p.notes %></p></div>
<% } %>

<p class="profile-section-title">Residences &amp; Migration</p>
<div id="residences-section">
  <%~ include("../partials/residences", { residences: it.residences, personId: p.id }) %>
</div>

<p class="profile-section-title">Family Relationships</p>
<div id="relationships-section">
  <%~ include("../partials/relationships", {
    parents: it.parents, spouses: it.spouses,
    children: it.children, siblings: it.siblings,
    personId: p.id, allPeople: it.allPeople
  }) %>
</div>

<p class="profile-section-title">Documents &amp; Photos</p>
<div id="documents-section">
  <%~ include("../partials/document-list", { documents: it.documents, personId: p.id }) %>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

<dialog id="crop-modal" class="crop-modal">
  <h3 class="crop-modal-title">Crop Image</h3>
  <div class="crop-container">
    <img id="crop-img" src="" alt="crop preview" />
  </div>
  <form id="crop-form" method="POST" action="">
    <input type="hidden" name="person_id" id="crop-person-id" />
    <input type="hidden" name="x" id="crop-x" />
    <input type="hidden" name="y" id="crop-y" />
    <input type="hidden" name="w" id="crop-w" />
    <input type="hidden" name="h" id="crop-h" />
    <input type="hidden" name="reset" id="crop-reset" value="" />
    <div class="crop-modal-actions">
      <button type="submit" class="primary">Save Crop</button>
      <button type="button" id="crop-reset-btn" class="outline">Remove Crop</button>
      <button type="button" class="outline" onclick="document.getElementById('crop-modal').close()">Cancel</button>
    </div>
  </form>
</dialog>

<script>
(function () {
  let currentCropper = null;
  let cropperReady = false;

  const modal = document.getElementById('crop-modal');
  const img = document.getElementById('crop-img');
  const form = document.getElementById('crop-form');
  const saveBtn = form.querySelector('button[type="submit"]');
  const resetBtn = document.getElementById('crop-reset-btn');

  window.openCropModal = function (btn) {
    form.action = '/api/documents/' + btn.dataset.docId + '/crop';
    document.getElementById('crop-person-id').value = btn.dataset.personId;
    document.getElementById('crop-reset').value = '';
    resetBtn.style.display = btn.dataset.hasCrop ? '' : 'none';

    saveBtn.disabled = true;
    cropperReady = false;
    if (currentCropper) { currentCropper.destroy(); currentCropper = null; }

    img.onload = function () {
      currentCropper = new Cropper(img, {
        viewMode: 1,
        autoCropArea: 1,
        ready: function () { cropperReady = true; saveBtn.disabled = false; },
      });
    };
    img.src = btn.dataset.signedUrl;
    modal.showModal();
  };

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!currentCropper || !cropperReady) return;
    const data = currentCropper.getData();
    const nw = img.naturalWidth, nh = img.naturalHeight;
    if (!nw || !nh) return;
    document.getElementById('crop-x').value = (data.x / nw).toFixed(6);
    document.getElementById('crop-y').value = (data.y / nh).toFixed(6);
    document.getElementById('crop-w').value = (data.width / nw).toFixed(6);
    document.getElementById('crop-h').value = (data.height / nh).toFixed(6);
    this.submit();
  });

  resetBtn.addEventListener('click', function () {
    document.getElementById('crop-reset').value = '1';
    form.submit();
  });
})();
</script>
