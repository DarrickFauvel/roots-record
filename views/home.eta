<% if (it.stats.peopleCount === 0) { %>

<div class="welcome-view">
  <div class="welcome-mark">R</div>
  <h1>Welcome to<br><em>Roots Record</em></h1>
  <p class="welcome-sub">Your family's living archive — preserve vital records, relationships, and documents across generations.</p>
  <div class="welcome-steps">
    <div class="welcome-step">
      <span class="welcome-step-num">1</span>
      <div>
        <strong>Add a person</strong>
        <span>Start with yourself or a family member</span>
      </div>
    </div>
    <div class="welcome-step">
      <span class="welcome-step-num">2</span>
      <div>
        <strong>Link relationships</strong>
        <span>Connect parents, spouses, and children</span>
      </div>
    </div>
    <div class="welcome-step">
      <span class="welcome-step-num">3</span>
      <div>
        <strong>Attach documents</strong>
        <span>Upload birth certificates, photos, and more</span>
      </div>
    </div>
  </div>
  <a href="/people/new" role="button" class="welcome-cta">Add Your First Person</a>
</div>

<% } else { %>

<div class="home-hero">
  <h1>Your family's<br><em>living archive</em></h1>
  <div class="home-actions">
    <a href="/people/new" role="button">Add Person</a>
    <a href="/people" role="button" class="outline">Browse All</a>
    <a href="/tree" role="button" class="outline">Family Tree</a>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <span class="stat-number"><%= it.stats.peopleCount %></span>
    <span class="stat-label">People</span>
  </div>
  <div class="stat-card">
    <span class="stat-number"><%= it.stats.relationshipCount %></span>
    <span class="stat-label">Relationships</span>
  </div>
  <div class="stat-card">
    <span class="stat-number"><%= it.stats.documentCount %></span>
    <span class="stat-label">Documents</span>
  </div>
</div>

<div class="recent-section">
  <h2>Recently Added</h2>
  <ul class="person-list">
    <% for (const p of it.recent) { %>
      <li class="person-card">
        <a href="/people/<%= p.id %>">
          <strong><%= p.given_name %><%= p.middle_name ? ` ${p.middle_name[0]}.` : "" %> <%= p.surname ?? "" %></strong>
          <span class="person-meta">
            <% if (p.birth_date) { %><span>b. <%= fmtDate(p.birth_date) %></span><% } %>
            <% if (p.death_date) { %><span>d. <%= fmtDate(p.death_date) %></span><% } %>
          </span>
        </a>
      </li>
    <% } %>
  </ul>
</div>

<% } %>
