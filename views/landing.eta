<div class="landing">

  <div class="landing-frame">

    <div class="landing-ornament" aria-hidden="true">
      <span class="landing-mark">R</span>
      <div class="landing-rule">
        <span class="landing-rule-line"></span>
        <span class="landing-rule-diamond">◆</span>
        <span class="landing-rule-line"></span>
      </div>
    </div>

    <div class="landing-title-block">
      <p class="landing-eyebrow">Est. in your family</p>
      <h1 class="landing-headline">Roots<br><em>Record</em></h1>
      <p class="landing-tagline">A living archive for your family's vital records,<br>relationships, and documents — across generations.</p>
    </div>

    <div class="landing-rule" aria-hidden="true">
      <span class="landing-rule-line"></span>
      <span class="landing-rule-diamond">◆</span>
      <span class="landing-rule-line"></span>
    </div>

    <div class="landing-features">
      <div class="landing-feature">
        <span class="landing-feature-glyph">❧</span>
        <strong>Vital Records</strong>
        <span>Birth, death, marriage dates and places preserved with care</span>
      </div>
      <div class="landing-feature">
        <span class="landing-feature-glyph">❧</span>
        <strong>Family Connections</strong>
        <span>Parents, children, spouses — the full web of relation</span>
      </div>
      <div class="landing-feature">
        <span class="landing-feature-glyph">❧</span>
        <strong>Documents &amp; Photos</strong>
        <span>Certificates, portraits, and heirlooms in one secure place</span>
      </div>
    </div>

    <div class="landing-actions">
      <a href="/login" role="button">Sign In</a>
      <a href="/register" role="button" class="outline">Create Account</a>
    </div>

    <div class="landing-demo-block">
      <a href="/login?demo=1" class="landing-demo-link">Explore the demo family →</a>
      <span class="landing-demo-or">or log in as a demo user:</span>
      <span class="landing-demo-field"><span class="landing-demo-field-label">username</span><code class="landing-demo-cred">demo</code></span>
      <span class="landing-demo-field"><span class="landing-demo-field-label">password</span><code class="landing-demo-cred">demo1234</code></span>
    </div>

    <p class="landing-footer-note">Private by design — your family history, yours alone.</p>

  </div>

</div>
