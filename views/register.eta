<div class="auth-wrap">
  <div class="auth-card">
    <h1>Create account</h1>
    <p class="auth-subtitle">Start building your family archive</p>

    <% if (it.error) { %>
      <p style="color:var(--rust);font-size:.875rem;margin-bottom:.5rem"><%= it.error %></p>
    <% } %>

    <form method="POST" action="/auth/register">
      <label for="name">Full name</label>
      <input id="name" type="text" name="name" autocomplete="name" required placeholder="Your name" />

      <label for="username">Username <span style="color:var(--muted);font-weight:400">(optional)</span></label>
      <input id="username" type="text" name="username" autocomplete="username" placeholder="yourname" pattern="[a-zA-Z0-9_-]+" title="Letters, numbers, underscores, hyphens only" />

      <label for="email">Email address</label>
      <input id="email" type="email" name="email" autocomplete="email" required placeholder="you@example.com" />

      <label for="password">Password</label>
      <input id="password" type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="8+ characters" />

      <div style="margin-top:1.75rem">
        <button type="submit" style="width:100%;justify-content:center">Create Account</button>
      </div>
    </form>

    <div class="auth-footer">
      Already have an account? <a href="/login">Sign in</a>
    </div>
  </div>
</div>
