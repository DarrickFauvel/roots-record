<div class="auth-wrap">
  <div class="auth-card">
    <h1>Welcome back</h1>
    <p class="auth-subtitle">Sign in to access your family records</p>

    <% if (it.error) { %>
      <p style="color:var(--rust);font-size:.875rem;margin-bottom:.5rem">Invalid credentials.</p>
    <% } %>

    <form method="POST" action="/auth/login">
      <label for="identifier">Email or username</label>
      <input id="identifier" type="text" name="identifier" autocomplete="username" required placeholder="you@example.com or yourname"<% if (it.prefillDemo) { %> value="demo"<% } %> />

      <label for="password">Password</label>
      <input id="password" type="password" name="password" autocomplete="current-password" required placeholder="••••••••"<% if (it.prefillDemo) { %> value="demo1234"<% } %> />

      <div style="margin-top:1.75rem">
        <button type="submit" style="width:100%;justify-content:center">Sign In</button>
      </div>
    </form>

    <div class="auth-footer">
      No account yet? <a href="/register">Create one</a>
    </div>
  </div>
</div>
