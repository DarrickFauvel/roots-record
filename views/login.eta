<div class="auth-wrap">
  <div class="auth-card">
    <h1>Welcome back</h1>
    <p class="auth-subtitle">Sign in to access your family records</p>

    <form
      data-signals='{"email":"","password":""}'
      data-on:submit.prevent="@post('/api/auth/sign-in/email', {contentType:'application/json'}).then((r)=>{ if(r.ok) window.location='/'; })"
    >
      <label for="email">Email address</label>
      <input id="email" type="email" name="email" autocomplete="email" required data-bind="email" placeholder="you@example.com" />

      <label for="password">Password</label>
      <input id="password" type="password" name="password" autocomplete="current-password" required data-bind="password" placeholder="••••••••" />

      <div style="margin-top:1.75rem">
        <button type="submit" style="width:100%;justify-content:center">Sign In</button>
      </div>
    </form>

    <div class="auth-footer">
      No account yet? <a href="/register">Create one</a>
    </div>
  </div>
</div>
